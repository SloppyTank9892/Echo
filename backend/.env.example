# Required for AI Chat and enhanced incident analysis
# Get a key: https://aistudio.google.com/apikey
# Copy this file to .env and paste your real key there (.env is gitignored)
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: tune response length (chat default 256 tokens, lower = shorter)
# GEMINI_CHAT_MAX_TOKENS=256
# GEMINI_TEMPERATURE=0.25
DATABASE_URL=sqlite+aiosqlite:///./echo.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
